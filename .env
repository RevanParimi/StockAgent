# ============================================================
# .env.example  —  copy to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ---- LLM (Groq) ----
GROQ_API_KEY=your-groq-api-key-here

# Available models (uncomment to override default):
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_MODEL=llama-3.1-8b-instant
# LLM_MODEL=mixtral-8x7b-32768
# LLM_MODEL=gemma2-9b-it

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

# ---- Data / Search APIs ----
SERPER_API_KEY=
ALPHA_VANTAGE_API_KEY=
NEWSAPI_KEY=
TWITTER_BEARER_TOKEN=

# ---- Agent Execution ----
AGENT_TIMEOUT_SECONDS=120
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2.0

# ---- Output ----
OUTPUT_DIR=outputs
REPORT_FORMAT=json        # json | markdown
LOG_LEVEL=INFO

# ---- RAG Pipeline (disabled by default) ----
RAG_ENABLED=false
# EMBEDDING_PROVIDER=groq
# EMBEDDING_MODEL=nomic-embed-text-v1.5
# VECTOR_STORE_PROVIDER=chromadb
# CHROMA_PERSIST_DIR=data/chroma_db
# RAG_TOP_K=5
# RAG_SIMILARITY_THRESHOLD=0.75

# ---- Scheduler (Phase 4) ----
SCHEDULER_ENABLED=false
# SCHEDULER_CRON=30 8 * * 1-5          # weekdays 8:30am IST
# SCHEDULER_TICKERS=MARUTI,TATAMOTORS,M&M,HEROMOTOCO,BAJAJ-AUTO
# SCORE_DB_PATH=data/scores.db
# SCORE_HISTORY_MAX_ROWS=90

# ---- Alerts (Phase 4) ----
# ALERT_SCORE_CHANGE_THRESHOLD=0.10     # fire if score changes by this much
# ALERT_ON_VERDICT_CHANGE=true
# ALERT_CHANNELS=console,file           # console | file | webhook
# ALERT_WEBHOOK_URL=                    # Slack/Discord incoming webhook URL
# ALERT_LOG_FILE=outputs/alerts.log
