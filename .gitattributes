# Normalize line endings to LF in the repo; checkout as-is on all platforms.
* text=auto eol=lf

# Explicitly LF for source files
*.py        text eol=lf
*.jsx       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.toml      text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
Dockerfile  text eol=lf
*.env*      text eol=lf

# Windows scripts stay CRLF
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Binary — no conversion
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.so        binary
*.db        binary
*.sqlite    binary
