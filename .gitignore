.venv/
venv/
env/
.stockai/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyo
*.so
.Python

# Environment / secrets — NEVER commit these
.env
.env.*
*.env
!.env.example

# Logs and generated data
logs/
*.jsonl
*.log

# Word / Office temp files
~$*
*.tmp

# Stray pip output files
=*

# OS / editor
.DS_Store
Thumbs.db
.idea/
