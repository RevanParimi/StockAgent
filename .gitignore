*.swp

# Distribution / build
dist/
build/
*.egg-info/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Data / outputs (runtime artifacts — created at runtime, not committed)
# Anchored to repo root: an unanchored `data/` also matched SOURCE packages
# named data (src/backend/shared/data, services/data, core/data, sectors/*/data),
# silently dropping new source files from commits/deploys. Keep these anchored.
/data/
/outputs/
*.db
*.sqlite

# C++ build artifacts
cpp/build/

# Node / TypeScript / Frontend
node_modules/
typescript/node_modules/
frontend/node_modules/
*.tsbuildinfo

# Claude Code internal worktrees
.claude/worktrees/

MagicMock/
analysis_data/

# Superpowers brainstorm session artifacts
.superpowers/

# Local dev seed data (fixture-seeded, per scripts/seed_fixture_ui.py)
.uidev-data/
