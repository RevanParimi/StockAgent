# ============================================================
# Caddyfile — StockAgent reverse proxy + auto HTTPS
#
# Replace YOUR_DOMAIN with:
#   - your domain (e.g. stockagent.yourdomain.com)  → auto HTTPS via Let's Encrypt
#   - your Droplet IP (e.g. 134.209.x.x)           → HTTP only (no TLS for bare IPs)
#
# After editing, restart Caddy:
#   docker compose restart caddy
# ============================================================

YOUR_DOMAIN {

    # ── REST API ────────────────────────────────────────────
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy typescript-gateway:3000
    }

    handle /analyse* {
        reverse_proxy python-api:8000
    }

    handle /history/* {
        reverse_proxy python-api:8000
    }

    handle /health {
        reverse_proxy python-api:8000
    }

    # ── WebSocket live stream ────────────────────────────────
    handle /ws/* {
        reverse_proxy typescript-gateway:3001 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # ── Scheduler health (internal use only) ────────────────
    handle /scheduler/* {
        reverse_proxy csharp-scheduler:5000
    }

    # ── Default → gateway ───────────────────────────────────
    handle {
        reverse_proxy typescript-gateway:3000
    }

    # Logging
    log {
        output file /data/caddy/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
