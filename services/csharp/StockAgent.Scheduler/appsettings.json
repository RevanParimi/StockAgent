{
  "Urls": "http://localhost:5000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=StockAgentScheduler;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Scheduler": {
    "PythonApiUrl": "http://localhost:8000",
    "CronExpression": "0 30 8 ? * MON-FRI",
    "Tickers": [ "MARUTI", "TATAMOTORS", "M&M", "HEROMOTOCO", "BAJAJ-AUTO" ],
    "AlertScoreDeltaThreshold": 0.10,
    "WebhookUrl": ""
  }
}
